{
  "name": "engcode",
  "displayName": "EngCode",
  "description": "Simple English programming for scripts, websites, and desktop apps.",
  "version": "1.0.0",
  "publisher": "engcode",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Debuggers"
  ],
  "keywords": [
    "engcode",
    "english",
    "beginner"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:engcode"
  ],
  "contributes": {
    "languages": [
      {
        "id": "engcode",
        "aliases": [
          "EngCode",
          "engcode"
        ],
        "extensions": [
          ".eng"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "engcode",
        "scopeName": "source.engcode",
        "path": "./syntaxes/engcode.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "engcode",
        "path": "./snippets/engcode.json"
      }
    ],
    "iconThemes": [
      {
        "id": "engcode",
        "label": "EngCode",
        "path": "./engcode-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "engcode.runFile",
        "title": "EngCode: Run File"
      },
      {
        "command": "engcode.serve",
        "title": "EngCode: Serve App"
      },
      {
        "command": "engcode.explain",
        "title": "EngCode: Explain File"
      },
      {
        "command": "engcode.check",
        "title": "EngCode: Check File"
      }
    ],
    "breakpoints": [
      {
        "language": "engcode"
      }
    ],
    "debuggers": [
      {
        "type": "engcode",
        "label": "EngCode",
        "program": "./dist/debugAdapter.js",
        "runtime": "node",
        "languages": [
          "engcode"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .eng file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before the first statement.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "engcode",
            "name": "Debug current file",
            "request": "launch",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "EngCode: Debug current file",
            "description": "Debug the .eng file that is open in the editor.",
            "body": {
              "type": "engcode",
              "name": "Debug current file",
              "request": "launch",
              "program": "${file}",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "EngCode",
      "properties": {
        "engcode.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "The EngCode command to run for Run/Serve/Explain. Leave empty to use the CLI bundled with this extension."
        },
        "engcode.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Check the file shortly after you stop typing."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/e2e.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.91.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vscode-languageclient": "^11.0.0",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  }
}
